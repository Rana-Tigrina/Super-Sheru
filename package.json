{
    "name": "super-sheru-bros",
    "private": true,
    "version": "2.0.0",
    "type": "module",
    "description": "सुपर शेरू · Super Sheru Bros — eight lands of Bharat. GRD v2: fixed-step physics, machine-proven levels, ghost-tested 8/8.",
    "scripts": {
        "dev": "vite",
        "build": "npm run palette && npm run prove && vite build",
        "preview": "vite preview",
        "palette": "node validate-palette.mjs",
        "prove": "node tools/grd-solver.mjs --all",
        "prove:one": "node tools/grd-solver.mjs --level",
        "ghosts": "node tests/generate-all-ghosts.mjs",
        "test": "node tests/run-grd-v1-suite.mjs",
        "bench": "node tools/benchmark.mjs"
    },
    "devDependencies": {
        "vite": "^5.4.8"
    }
}